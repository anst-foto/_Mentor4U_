<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- <Versions> -->
    <AvaloniaVersion>12.0.4</AvaloniaVersion>
    <ReactiveUIAvaloniaVersion>11.3.8</ReactiveUIAvaloniaVersion>
    <ReactiveUISourceGeneratorsVersion>4.2.0</ReactiveUISourceGeneratorsVersion>
    <NpgsqlVersion>10.0.3</NpgsqlVersion>
    <MicrosoftNETTestSdk>18.11.0</MicrosoftNETTestSdk>
    <xUnit>2.9.3</xUnit>
    <xUnitRunnerVisualstudio>4.0.1</xUnitRunnerVisualstudio>
    <TestcontainersPostgreSql>4.16.0</TestcontainersPostgreSql>
    <!-- </Versions> -->
  </PropertyGroup>

  <ItemGroup>
    <!-- <Avalonia> -->
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)"/>
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)"/>
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)"/>
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)"/>
    <!-- </Avalonia> -->

    <!-- <ReactiveUI> -->
    <PackageVersion Include="ReactiveUI.Avalonia" Version="$(ReactiveUIAvaloniaVersion)"/>
    <PackageVersion Include="ReactiveUI.SourceGenerators" Version="$(ReactiveUISourceGeneratorsVersion)"/>
    <!-- </ReactiveUI> -->
    
    <!-- <EF> -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(NpgsqlVersion)" />
    <!-- </EF> -->
    
    <!-- <Test> -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="$(MicrosoftNETTestSdk)" />
    <PackageVersion Include="xunit" Version="$(xUnit)" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="$(xUnitRunnerVisualstudio)" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="$(TestcontainersPostgreSql)" />
    <!-- </Test> -->
  </ItemGroup>
</Project>